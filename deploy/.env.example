# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env

# 后台密码（必填，默认值 ecy-admin 不安全）
ECY_ADMIN_PASSWORD=change-me-please

# 对外域名，例如 https://api.example.com；留空则按请求 Host 推断
ECY_BASE_URL=

# 宿主端口
HTTP_PORT=8080

# 单次请求最多返回多少条链接
ECY_MAX_LINKS=50

# 单次上传请求体上限（MB）
ECY_MAX_UPLOAD_MB=512

# 分类层级上限（默认 3、最大 8）；调大后可支持 a/b/c/d 更深目录
ECY_MAX_DEPTH=3

# 图库默认展示分类的全部图片；设为 >0 时改为随机抽样 N 张（超大分类兜底）
ECY_GALLERY_MAX=0

# 图库同时渲染的并发上限与排队等待秒数：内存上限 = 并发数 × 单次渲染开销
ECY_GALLERY_CONCURRENCY=2
ECY_GALLERY_WAIT=5

# 缩略图压缩的总像素预算（百万像素，默认 16）；4K 图约 8MP，
# 预算 16 表示最多同时压 2 张，其余回退原图。内存充足的机器可调到 64/128
ECY_PREVIEW_MP=16

# Go 运行时软内存上限（字节）
ECY_MEMORY_LIMIT=536870912

# 访问日志：留空开启；off 关闭
ECY_ACCESS_LOG=

TZ=Asia/Shanghai
