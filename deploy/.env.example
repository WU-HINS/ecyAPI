# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env

# 后台密码（必填，默认值 ecy-admin 不安全）
ECY_ADMIN_PASSWORD=change-me-please

# 对外域名，例如 https://api.example.com；留空则按请求 Host 推断
ECY_BASE_URL=

# 宿主端口
HTTP_PORT=8080

# 单次请求最多返回多少条链接
ECY_MAX_LINKS=50

# 单次上传请求体上限（MB）
ECY_MAX_UPLOAD_MB=512

# 分类层级上限（默认 3、最大 8）；调大后可支持 a/b/c/d 更深目录
ECY_MAX_DEPTH=3

# 图库默认展示分类的全部图片；设为 >0 时改为随机抽样 N 张（超大分类兜底）
ECY_GALLERY_MAX=0

# 图库同时渲染的并发上限与排队等待秒数：内存上限 = 并发数 × 单次渲染开销
ECY_GALLERY_CONCURRENCY=2
ECY_GALLERY_WAIT=5

# 缩略图压缩的总像素预算（百万像素）；留空 = 按内存上限自适应（约 GOMEMLIMIT/12）
# 4K 图约 8MP，预算 32 表示同时压约 3 张，其余回退原图并由后台补缓存
ECY_PREVIEW_MP=

# 缩略图缓存文件数上限（默认 20000）
ECY_PREVIEW_CACHE_FILES=20000

# 后台增量刷新间隔（秒）；扫描不在请求路径上
ECY_SCAN_INTERVAL=3

# 首次扫描等待上限（秒）：到点没扫完就先启动、后台继续扫；0 = 等扫描完成再启动
ECY_STARTUP_WAIT=15

# 运行期把索引写到磁盘快照的周期（秒）；0 = 关闭快照
ECY_SNAPSHOT_TTL=300

# 启动时接受的最大快照年龄（秒，默认 30 天）；超龄则回退全量扫描；0 = 不做过期判断
ECY_SNAPSHOT_MAX_AGE=2592000

# 父目录聚合模式：with_files = 父目录有图时也聚合子目录（默认）；dirs_only = 仅无图的父目录聚合
ECY_PARENT_AGG=with_files

# 看板娘素材目录（默认 data/static）；镜像里由 Dockerfile 设为 /app/data/static
# ECY_STATIC_DIR=/app/data/static
# 启动时从该目录把素材同步进 ECY_STATIC_DIR（镜像里设为 /app/static）
# ECY_STATIC_SYNC_FROM=/app/static

# 强制完整校验间隔（秒，默认 1 小时）：条目名没变时，最多隔这么久把目录里文件 stat 一遍，
# 用来发现「同名文件被原地替换」。库很大（几十万张）时可调到 21600（6 小时）
ECY_VERIFY_INTERVAL=3600

# 302 前校验目标文件是否还存在；设为 off 可省一次 stat（默认开启）
ECY_VERIFY_LINKS=

# 内存预算（字节）；留空 = 自动取容器 cgroup 限制
ECY_MEMORY_LIMIT=

# 内存软目标 / 红线百分比：RSS 稳定在软目标附近，越红线前主动降档
ECY_MEM_SOFT_PCT=75
ECY_MEM_HARD_PCT=90

# 访问日志：留空开启；off 关闭
ECY_ACCESS_LOG=

TZ=Asia/Shanghai
